# Database
DATABASE_URL=sqlite:///./storycast.db

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Gemini - required
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Hosted open-source media models - required for narration and scene videos
HF_TOKEN=
TTS_PROVIDER=huggingface
HF_TTS_PROVIDER=auto
HF_TTS_MODEL=hexgrad/Kokoro-82M
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_HI=hf_alpha
VIDEO_PROVIDER=huggingface
HF_VIDEO_PROVIDER=fal-ai
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_VIDEO_FRAMES=81
HF_VIDEO_INFERENCE_STEPS=30
HF_VIDEO_GUIDANCE_SCALE=5

# Storage
STORAGE_PROVIDER=local
STORAGE_ROOT=storage

# S3-compatible storage - optional
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_REGION=
# Leave these empty on AWS EC2 to use the instance IAM role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Application URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000

# Collection configuration
SOURCE_USER_AGENT=StoryCast/0.1 (+local news video creator)
SOURCE_TIMEOUT_SECONDS=15
MAX_ARTICLE_BYTES=2000000
CRAWL_DELAY_SECONDS=0.5
FRESHNESS_HOURS=72

# Mock media should remain disabled outside tests
ALLOW_MOCK_MEDIA=false

# Model cost tracking
# Change these to the current provider prices if cost estimation is needed.
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
