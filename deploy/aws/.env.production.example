# Public endpoint. Point this DNS name at the EC2 Elastic IP before starting Caddy.
APP_DOMAIN=storycast.example.com
ACME_EMAIL=you@example.com

# Caddy requires a bcrypt hash, not a plaintext password. Keep the single quotes.
BASIC_AUTH_USERNAME=reviewer
BASIC_AUTH_PASSWORD_HASH='$2a$14$REPLACE_WITH_OUTPUT_FROM_CADDY_HASH_PASSWORD'

# Container images. CI overrides these with immutable commit-tagged ECR images.
BACKEND_IMAGE=storycast-backend:latest
FRONTEND_IMAGE=storycast-frontend:latest

# Database. Use a long alphanumeric password so it is safe inside DATABASE_URL.
POSTGRES_DB=storycast
POSTGRES_USER=storycast
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_ALPHANUMERIC
DATABASE_URL=postgresql+psycopg://storycast:CHANGE_ME_LONG_RANDOM_ALPHANUMERIC@db:5432/storycast

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Hosted AI services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
HF_TOKEN=
TTS_PROVIDER=huggingface
HF_TTS_PROVIDER=auto
HF_TTS_MODEL=hexgrad/Kokoro-82M
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_HI=hf_alpha
VIDEO_PROVIDER=huggingface
HF_VIDEO_PROVIDER=fal-ai
HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
HF_VIDEO_FRAMES=81
HF_VIDEO_INFERENCE_STEPS=30
HF_VIDEO_GUIDANCE_SCALE=5
ALLOW_MOCK_MEDIA=false

# Private S3 storage. Leave access keys blank to use the EC2 IAM role.
STORAGE_PROVIDER=s3
STORAGE_ROOT=/app/storage
AWS_REGION=ap-south-1
S3_BUCKET=CHANGE_ME_STORYCAST_BUCKET
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Browser/API configuration. Use the real HTTPS origin here.
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGINS=https://storycast.example.com

# Collection configuration
SOURCE_USER_AGENT=StoryCast/0.1 (+https://storycast.example.com)
SOURCE_TIMEOUT_SECONDS=15
MAX_ARTICLE_BYTES=2000000
CRAWL_DELAY_SECONDS=0.5
FRESHNESS_HOURS=72

# Optional Gemini cost estimation
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
